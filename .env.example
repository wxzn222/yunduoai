# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# 通义千问（DashScope）兼容模式 API Key
# https://help.aliyun.com/zh/model-studio/
DASHSCOPE_API_KEY=****

# 危机告警机器人（可选）
# 钉钉自定义机器人示例；机器人“安全设置”若选了自定义关键词，
# 请填“告警”或“云朵”，因为告警正文包含“【AI 云朵 · 危机告警】”
# CRISIS_ALERT_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=你的token

# 云朵短期上下文保留的最近用户轮数（默认 8，最大 20）
# YUNDUO_SHORT_TERM_TURNS=8
